generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FRONT_DESK
  PROVIDER
}

enum AppointmentStatus {
  AVAILABLE
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentHistoryType {
  STATUS_CHANGE
  SUPPORTING_PROVIDER_ADDED
  SUPPORTING_PROVIDER_REMOVED
  CANCELLATION
  VISIT_NOTE_ADDED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider      Provider?
  historyEvents AppointmentHistory[]
}

model Provider {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                 @relation(fields: [userId], references: [id])
  appointments           Appointment[]
  supportingAppointments AppointmentSupport[]
  visitNotes             VisitNote[]

  historyEvents AppointmentHistory[] @relation("HistoryProvider")
}

model Patient {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id         Int               @id @default(autoincrement())
  providerId Int
  patientId  Int?
  startTime  DateTime
  duration   Int
  status     AppointmentStatus @default(AVAILABLE)
  archived   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  provider            Provider             @relation(fields: [providerId], references: [id])
  patient             Patient?             @relation(fields: [patientId], references: [id])
  visitNotes          VisitNote[]
  supportingProviders AppointmentSupport[]
  historyEvents       AppointmentHistory[]
}

model AppointmentSupport {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  providerId    Int
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, providerId])
}

model VisitNote {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  providerId    Int
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  provider    Provider    @relation(fields: [providerId], references: [id])

  historyEvents AppointmentHistory[] @relation("HistoryVisitNote")
}

model AppointmentHistory {
  id            Int                    @id @default(autoincrement())
  appointmentId Int
  actorUserId   Int
  type          AppointmentHistoryType
  oldStatus     AppointmentStatus?
  newStatus     AppointmentStatus?
  providerId    Int?
  visitNoteId   Int?
  reason        String?
  createdAt     DateTime               @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  actor       User        @relation(fields: [actorUserId], references: [id])

  provider  Provider?  @relation("HistoryProvider", fields: [providerId], references: [id])
  visitNote VisitNote? @relation("HistoryVisitNote", fields: [visitNoteId], references: [id])

  @@index([appointmentId, createdAt])
}
